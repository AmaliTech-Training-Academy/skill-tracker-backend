# ===============================================
# Skill Tracker Backend - Environment Variables
# ===============================================
# Copy this file to .env and fill in your values
# cp .env.example .env
#
# NOTE: This file contains ALL variables used by services and docker-compose files.
# Variables are sourced from:
# 1. This .env file (highest priority - used as overrides)
# 2. Spring Cloud Config Server (from https://github.com/thenoblet/skilltracker-config)
# 3. Application defaults (lowest priority)

# ===============================================
# SPRING ENVIRONMENT
# ===============================================
SPRING_PROFILES_ACTIVE=dev
LOG_LEVEL=INFO

# ===============================================
# POSTGRESQL DATABASE (Primary Database)
# ===============================================
# Shared primary database for: user, task, feedback services
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# Task Service (separate credentials for security)
POSTGRES_TASK_USER=
POSTGRES_TASK_PASSWORD=

# Feedback Service (separate credentials for security)
POSTGRES_FEEDBACK_USER=
POSTGRES_FEEDBACK_PASSWORD=

# ===============================================
# MONGODB (Primary Instance - root docker-compose)
# ===============================================
SPRING_DATA_MONGODB_DATABASE=
SPRING_DATA_MONGODB_USERNAME=
SPRING_DATA_MONGODB_PASSWORD=
SPRING_DATA_MONGODB_HOST=

# ===============================================
# MONGODB (Analytics Service - Separate Instance)
# ===============================================
MONGO_ANALYTICS_DB=
MONGO_ANALYTICS_USER=
MONGO_ANALYTICS_PASSWORD=

# ===============================================
# MONGODB (Notification Service - Separate Instance)
# ===============================================
MONGO_NOTIFICATION_DB=
MONGO_NOTIFICATION_USER=
MONGO_NOTIFICATION_PASSWORD=

# ===============================================
# MONGODB (Service-Specific Instances - Generic Variables)
# ===============================================
# Used by gamification, practice, and payment service docker-compose files
# Each service has its own MongoDB container with these credentials
MONGO_DB=
MONGO_USER=
MONGO_PASSWORD=

# ===============================================
# RABBITMQ MESSAGE BROKER
# ===============================================
RABBITMQ_USER=
RABBITMQ_PASSWORD=
SPRING_RABBITMQ_HOST=
SPRING_RABBITMQ_PORT=
RABBITMQ_STOMP_PORT=

# ===============================================
# SERVICE DISCOVERY & INFRASTRUCTURE
# ===============================================
# Eureka Service Discovery
DISCOVERY_HOST=
DISCOVERY_PORT=
EUREKA_USER=
EUREKA_PASSWORD=

# Config Server
CONFIG_HOST=
CONFIG_PORT=
CONFIG_REPO=

# ===============================================
# SERVICE ENDPOINTS (Local Development)
# ===============================================
GATEWAY_HOST=
GATEWAY_PORT=
BASE_URL=

USER_SERVICE_HOST=
USER_SERVICE_PORT=

# ===============================================
# AUTHENTICATION & JWT
# ===============================================
# JWT configuration - used by User Service and API Gateway
JWT_SECRET=
HMAC_SECRET_KEY=
HMAC_ALGORITHM=
JWT_EXPIRATION=
JWT_ACCESS_EXPIRATION=
JWT_REFRESH_EXPIRATION=
RESET_TOKEN_EXPIRATION=

# ===============================================
# OAUTH2 / GOOGLE LOGIN
# ===============================================
# OAuth2 configuration for Google Sign-In
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_AUTHORIZATION_URI=
GOOGLE_TOKEN_URI=
GOOGLE_USER_INFO_URI=

# ===============================================
# MAIL CONFIGURATION (Notification Service)
# ===============================================
# SMTP configuration for sending emails
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_PROTOCOL=
MAIL_SMTP_AUTH=
MAIL_STARTTLS_ENABLE=

# ===============================================
# EXTERNAL AI & CODE EVALUATION
# ===============================================
# OpenAI API key (Task Service - AI task generation)
OPENAI_API_KEY=

# Judge0 (Code Execution & Evaluation)
JUDGE0_API_KEY=
JUDGE0_BASE_URL=

# Gemini API (Alternative AI provider)
GEMINI_API_KEY=

# Google Maps API
GOOGLE_API_KEY=

# SendGrid Email Service
SENDGRID_API_KEY=

# ===============================================
# FRONTEND & CLIENT CONFIGURATION
# ===============================================
FRONTEND_URL=
LOGIN_URL=
COOKIE_DOMAIN=
COOKIE_SECURE=

# ===============================================
# NGROK TUNNEL (Optional - Development Only)
# ===============================================
# For exposing local services to the internet
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# ===============================================
# AWS CONFIGURATION
# ===============================================
AWS_REGION=
