-- =====================================================
-- PostgreSQL Initialization Script - TEMPLATE
-- Skill Tracker Backend - Multi-Schema Setup
-- =====================================================
-- 
-- INSTRUCTIONS:
-- 1. Copy this file to init-postgres.sql
-- 2. Replace the placeholder passwords with actual values from your .env file
-- 3. Never commit init-postgres.sql to version control
-- 
-- =====================================================

-- Create schemas for each service
CREATE SCHEMA IF NOT EXISTS user_schema;
CREATE SCHEMA IF NOT EXISTS task_schema;
CREATE SCHEMA IF NOT EXISTS feedback_schema;
CREATE SCHEMA IF NOT EXISTS payment_schema;
CREATE SCHEMA IF NOT EXISTS practice_schema;

-- Create dedicated users for each schema
-- IMPORTANT: Replace these passwords with values from your .env file
CREATE USER user_admin WITH PASSWORD 'YOUR_POSTGRES_USER_PASSWORD';
CREATE USER task_admin WITH PASSWORD 'YOUR_POSTGRES_TASK_PASSWORD';
CREATE USER feedback_admin WITH PASSWORD 'YOUR_POSTGRES_FEEDBACK_PASSWORD';
CREATE USER payment_admin WITH PASSWORD 'YOUR_POSTGRES_PAYMENT_PASSWORD';
CREATE USER practice_admin WITH PASSWORD 'YOUR_POSTGRES_PRACTICE_PASSWORD';

-- Grant schema permissions
GRANT ALL PRIVILEGES ON SCHEMA user_schema TO user_admin;
GRANT ALL PRIVILEGES ON SCHEMA task_schema TO task_admin;
GRANT ALL PRIVILEGES ON SCHEMA feedback_schema TO feedback_admin;
GRANT ALL PRIVILEGES ON SCHEMA payment_schema TO payment_admin;
GRANT ALL PRIVILEGES ON SCHEMA practice_schema TO practice_admin;

-- Grant all privileges on all tables (current and future)
GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA user_schema TO user_admin;
GRANT ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA user_schema TO user_admin;
GRANT ALL PRIVILEGES ON ALL FUNCTIONS IN SCHEMA user_schema TO user_admin;
ALTER DEFAULT PRIVILEGES IN SCHEMA user_schema GRANT ALL ON TABLES TO user_admin;
ALTER DEFAULT PRIVILEGES IN SCHEMA user_schema GRANT ALL ON SEQUENCES TO user_admin;

GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA task_schema TO task_admin;
GRANT ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA task_schema TO task_admin;
GRANT ALL PRIVILEGES ON ALL FUNCTIONS IN SCHEMA task_schema TO task_admin;
ALTER DEFAULT PRIVILEGES IN SCHEMA task_schema GRANT ALL ON TABLES TO task_admin;
ALTER DEFAULT PRIVILEGES IN SCHEMA task_schema GRANT ALL ON SEQUENCES TO task_admin;

GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA feedback_schema TO feedback_admin;
GRANT ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA feedback_schema TO feedback_admin;
GRANT ALL PRIVILEGES ON ALL FUNCTIONS IN SCHEMA feedback_schema TO feedback_admin;
ALTER DEFAULT PRIVILEGES IN SCHEMA feedback_schema GRANT ALL ON TABLES TO feedback_admin;
ALTER DEFAULT PRIVILEGES IN SCHEMA feedback_schema GRANT ALL ON SEQUENCES TO feedback_admin;

GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA payment_schema TO payment_admin;
GRANT ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA payment_schema TO payment_admin;
GRANT ALL PRIVILEGES ON ALL FUNCTIONS IN SCHEMA payment_schema TO payment_admin;
ALTER DEFAULT PRIVILEGES IN SCHEMA payment_schema GRANT ALL ON TABLES TO payment_admin;
ALTER DEFAULT PRIVILEGES IN SCHEMA payment_schema GRANT ALL ON SEQUENCES TO payment_admin;

GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA practice_schema TO practice_admin;
GRANT ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA practice_schema TO practice_admin;
GRANT ALL PRIVILEGES ON ALL FUNCTIONS IN SCHEMA practice_schema TO practice_admin;
ALTER DEFAULT PRIVILEGES IN SCHEMA practice_schema GRANT ALL ON TABLES TO practice_admin;
ALTER DEFAULT PRIVILEGES IN SCHEMA practice_schema GRANT ALL ON SEQUENCES TO practice_admin;

-- Set default search path for each user
ALTER USER user_admin SET search_path TO user_schema;
ALTER USER task_admin SET search_path TO task_schema;
ALTER USER feedback_admin SET search_path TO feedback_schema;
ALTER USER payment_admin SET search_path TO payment_schema;
ALTER USER practice_admin SET search_path TO practice_schema;

-- Log initialization
\echo 'PostgreSQL multi-schema initialization completed successfully!'
\echo 'Created schemas: user_schema, task_schema, feedback_schema, payment_schema, practice_schema'
\echo 'Created users: user_admin, task_admin, feedback_admin, payment_admin, practice_admin'
